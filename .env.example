# Copy to .env (repo root or backend/) and fill in. .env is git-ignored; never commit real credentials.
# Variables already exported in your shell take precedence over this file.

# ---------- LLM path ----------
# Bedrock model ID or cross-region inference profile ID.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# Region of the Bedrock endpoint (required by the SDK).
AWS_REGION=us-east-1

# ---------- Bedrock auth: pick ONE option ----------

# Option A: Bedrock API key (bearer token). Also what most corporate Bedrock gateways issue.
# AWS_BEARER_TOKEN_BEDROCK=

# Option B: standard AWS credentials, resolved by boto3 (profile, env keys, SSO, or instance role).
# Leave AWS_BEARER_TOKEN_BEDROCK unset when using this option; the SDK rejects both at once.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: send requests to a Bedrock-compatible gateway or proxy instead of
# https://bedrock-runtime.<AWS_REGION>.amazonaws.com
# ANTHROPIC_BEDROCK_BASE_URL=https://your-gateway.example.com/bedrock

# ---------- Tuning (optional) ----------
# Effort for Claude Sonnet 5.5: low | medium | high. Low keeps answers fast; quality held on the eval set.
LLM_EFFORT=low
# Max model round trips per question before the request fails with "iteration_cap".
LLM_MAX_ITERATIONS=6
# Per-request timeout to Bedrock, in seconds.
LLM_TIMEOUT_SECONDS=90

# ---------- Frontend (frontend/.env, optional) ----------
# VITE_API_URL=http://localhost:8000
